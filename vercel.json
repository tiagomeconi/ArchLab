{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes pnpm@12.8.1 install --frozen-lockfile --config.strictDepBuilds=false",
  "buildCommand": "pnpm --filter @archlab/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/((?!assets/|shots/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
