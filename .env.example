# Supabase (login e dados por usuário). Crie o projeto em https://supabase.com, rode
# supabase/migrations/0001_init.sql no SQL Editor e copie os valores de Project Settings > API.
# A chave "anon" é pública por desenho (a proteção dos dados é a RLS das tabelas):
# NUNCA use aqui a chave "service_role". Copie este arquivo para `apps/web/.env.local`
# (ignorado pelo git) para rodar localmente; na Vercel/Netlify, cadastre como variáveis de ambiente.
#
# Sem estas variáveis o app funciona em modo local, sem login (tudo salvo no navegador).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# Termos de uso e política de privacidade (opcional, mas recomendado: aparecem no texto das páginas /termos e /privacidade)
VITE_LEGAL_NAME=
VITE_CONTACT_EMAIL=

# Endereço público do site (links dos e-mails de confirmação/recuperação). Em produção, ponha o domínio publicado, ex.: https://archlab.vercel.app
VITE_SITE_URL=
